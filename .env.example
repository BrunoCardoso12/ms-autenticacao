# =====================================================================
# MODELO das variáveis de produção.
#
#   1. Copie:     cp .env.example .env
#   2. Preencha o .env com os valores reais
#   3. NUNCA faça commit do .env (ele já está no .gitignore)
#
# Este arquivo (.env.example) VAI para o git: documenta o que precisa existir,
# sem conter nenhum segredo.
# =====================================================================

# Domínio público da API (precisa apontar para o servidor, via DNS)
DOMAIN=api.meusite.com

# Banco de dados
POSTGRES_DB=autenticacao
POSTGRES_USER=autenticacao
# Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# A chave do JWT NÃO fica aqui: ela é um arquivo (secrets/jwt-private.pem).
# Veja como gerar no final do compose.prod.yaml.

# Servidor de email (SMTP) real: SendGrid, Amazon SES, Mailgun, Gmail (senha de app)...
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@meusite.com

# Sites (frontends) que podem chamar a API pelo navegador, separados por vírgula (opcional)
CORS_ALLOWED_ORIGINS=https://meusite.com

# Primeiro administrador (opcional). Depois de criado, pode remover estas linhas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
